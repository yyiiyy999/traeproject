# OpenAI兼容协议的LLM配置
# 复制此文件为.env并填写正确参数

# API基础URL
BASE_URL="https://api.example.com/v1"

# 模型名称
MODEL="gpt-3.5-turbo"

BASE_URL="https://openrouter.ai/api/v1"
MODEL=nvidia/nemotron-3-super-120b-a12b:free
API_KEY=""
ANYTHINGLLM_API_KEY=""
ANYTHINGLLM_WORKSPACE_SLUG="project"

# 温度参数 (0.0-1.0)
TEMPERATURE=0.7

# 最大令牌数
MAX_TOKENS=1000
